{
  "manifest_version": 3,
  "name": "AlgoSync AI",
  "version": "1.0.0",
  "description": "Automatically documents and visualizes your LeetCode solutions",
  "permissions": ["storage", "activeTab", "unlimitedStorage", "identity"],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://cool-mode-3295.algosync-svk.workers.dev/*",
    "https://github.com/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["toast.js", "keepalive.js", "content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2"],
      "matches": ["<all_urls>"]
    }
  ]
}